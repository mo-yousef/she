    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "leaflet": "1.9.4",
    "lucide-react": "^0.454.0",
    "next": "^15.5.4",
    "next-auth": "5.0.0-beta.25",
    "next-intl": "^3.25.1",
    "nodemailer": "^6.9.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "6.37.0",
    "twilio": "6.2.0",
