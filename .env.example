# --- Database ---
# Postgres. Local: postgresql://user:pass@localhost:5432/shecy
# Neon/Supabase: use their pooled + direct URLs.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shecy?schema=public"
# Direct (non-pooled) URL for migrations if using a pooler (e.g. Neon/Supabase).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shecy?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
# Google OAuth (optional in dev)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="she.cy <bookings@she.cy>"
# Svix signing secret ("whsec_...") of the Resend webhook pointing at
# {NEXT_PUBLIC_SITE_URL}/api/webhooks/resend. Unset = webhook rejects everything (403).
RESEND_WEBHOOK_SECRET=""

# --- SMS / WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_SMS_FROM="+357..."

# --- Uploads (choose one; Cloudinary by default) ---
# Business photos use SIGNED direct browser uploads. All three are needed; if any is empty the
# dashboard shows "Photo uploads are not configured". The API secret is server-only.
# In the Cloudinary console: allow only jpg/jpeg/png/webp (turn off svg, gif, pdf), cap image
# file size at ~5 MB (Upload limits), disable unsigned uploading. Uploads land in she/<businessId>.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
UPLOADTHING_TOKEN=""

# --- Abuse protection ---
# Cloudflare Turnstile (guest bookings). Both required in production; if the secret is
# unset in dev/test the check is skipped. Test keys: developers.cloudflare.com/turnstile/troubleshooting/testing
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Signed manage-booking links ---
# Generate: openssl rand -base64 32
MANAGE_TOKEN_SECRET="change-me"
# Optional separate key for review phone codes / receipts. Falls back to MANAGE_TOKEN_SECRET.
OTP_SECRET=""

# --- Cron (Vercel Cron secret header) ---
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/*. Unset = cron rejected.
# Generate: openssl rand -hex 32
CRON_SECRET="change-me"

# --- Observability ---
SENTRY_DSN=""

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
